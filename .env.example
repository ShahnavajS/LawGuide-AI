# LexiGuide AI - Environment Configuration Example
# Copy this file to .env.local for local development
# NEVER commit real API keys or secrets to version control.

# Google Gemini API Configuration (Server-side ONLY)
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection
# Recommended options:
# - gemini-2.5-flash (Fast, cost-effective, strong reasoning & document comprehension)
# - gemini-2.0-flash (Alternative fast model)
# - gemini-2.5-pro   (High reasoning depth for complex multi-page legal contracts)
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (SQLite)
# Path to the local SQLite database file relative to workspace root
DATABASE_URL=./data/lexiguide.db

# Document Storage Configuration
# Local directory for uploaded legal documents (isolated from public assets)
STORAGE_DIR=./uploads

# Required for production: set both to real independent secrets.
# Leave both unset for the optional local development access mode.
# APP_ACCESS_PASSWORD=<at least 16 characters>
# APP_SESSION_SECRET=<at least 32 random characters>

# Environment Mode
NODE_ENV=development
